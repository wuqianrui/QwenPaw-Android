<?xml version="1.0" encoding="utf-8"?>
<!-- 会话条目内容卡片的「滑动中」背景(与 bg_account_item 同款涟漪与描边):
     右滑露出菜单时内容层右边缘位于条目中间,圆角会在接缝处形成弧形缺口,故右侧改直角;
     左侧仍为圆角(左边缘滑出条目外,由父布局裁剪) -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/primary_color_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners
                android:bottomLeftRadius="14dp"
                android:topLeftRadius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card" />
            <stroke
                android:width="1dp"
                android:color="@color/stroke_card" />
            <corners
                android:bottomLeftRadius="14dp"
                android:topLeftRadius="14dp" />
        </shape>
    </item>
</ripple>
